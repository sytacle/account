{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/v1/:path*" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/admin/:path*", "destination": "/api/admin/:path*" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
