# Copy this file to .env.local and fill in your Firebase project's web
# app config: Firebase Console -> Project settings -> General -> Your
# apps -> SDK setup and configuration -> Config.
#
# Only the first three are required for Auth + Firestore, which is all
# this app uses. Analytics and App Check are optional (see
# src/config/firebase/index.js) — leave their vars blank to skip them.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Optional
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_RECAPTCHA_SITE_KEY=

# OAuth API base URL used by the consent screen.
VITE_OAUTH_API_URL=https://api.sytacle.com
VITE_SSO_HUB_ORIGIN=https://sytacle.com

# REST Countries v5 requires an API key. Create one at
# https://restcountries.com/sign-up.
VITE_REST_COUNTRIES_URL=https://api.restcountries.com/countries/v5?response_fields=names.common,codes.alpha_2&limit=300
VITE_REST_COUNTRIES_API_KEY=

# --- Firebase Console setup checklist -----------------------------------
# 1. Authentication -> Sign-in method -> enable "Email/Password", then
#    enable its "Email link (passwordless sign-in)" option. This app sends
#    sign-in links with sendSignInLinkToEmail, which will fail with
#    auth/operation-not-allowed unless Email link is enabled.
# 2. Authentication -> Sign-in method -> enable "Google".
# 3. Authentication -> Sign-in method -> enable "GitHub":
#      - Create an OAuth App at https://github.com/settings/developers
#      - Homepage URL: your app's URL
#      - Authorization callback URL: the one Firebase shows on this
#        provider's setup screen (looks like
#        https://<project-id>.firebaseapp.com/__/auth/handler)
#      - Paste the GitHub Client ID + Client Secret back into Firebase
# 4. Authentication -> Settings -> Authorized domains -> add localhost
#    (already there by default) and any domain you deploy to.
# 5. Firestore Database -> create a database (production or test mode).
#    Deploy the checked-in rules after replacing the project in .firebaserc
#    (or passing --project): firebase deploy --only firestore:rules
#    OAuth client validation and authorization are performed by the OAuth API.
#
# 6. Create each OAuth client document in the clients collection using a
#    non-client-admin workflow. firebase/clients/demo-app.json is a complete
#    development seed: create clients/demo-app in the Firestore console and
#    copy its fields. Register every allowed callback exactly in redirectUris.
#    Then test with:
#    /oauth/authorize?client_id=demo-app&redirect_uri=https%3A%2F%2Facme.example%2Fcallback&response_type=code&scope=openid&code_challenge=<S256_CHALLENGE>&code_challenge_method=S256
#
#    The checked-in firestore.rules are:
#
#      rules_version = '2';
#      service cloud.firestore {
#        match /databases/{database}/documents {
#          match /users/{uid} {
#            allow read, write: if request.auth != null && request.auth.uid == uid;
#          }
#          match /clients/{clientId} {
#            allow get: if request.auth != null;
#          }
#        }
#      }
